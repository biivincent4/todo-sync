    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/firestore": "^27.1.0",
    "@react-native-firebase/storage": "^27.1.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.0",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-contacts": "~58.0.10",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
